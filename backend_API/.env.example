DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cineverse

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
# Minutos que dura una sesión (por defecto 60)
TOKEN_MINUTES=60

# Recuperar contraseña por correo (Gmail con "contraseña de aplicación").
# Si se dejan vacíos, el código de recuperación solo se imprime en la
# terminal de uvicorn (útil para pruebas).
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
